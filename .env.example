# Local FractalU Studio / CLI (never exposed to the browser)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Public, tokenless published FractalU catalog configuration (no token)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Stripe Customer Portal no-code login link for /members
# Dashboard → Settings → Billing → Customer portal → Activate link
# Example: https://billing.stripe.com/p/login/live_xxxxxxxx
# See docs/members-home.md
VITE_STRIPE_CUSTOMER_PORTAL_URL=
