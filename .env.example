# Local FractalU Studio / CLI (never exposed to the browser)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Public, tokenless published FractalU catalog configuration (no token)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Stripe Customer Portal no-code login for /members (optional override)
# Default is the live URL in src/data/member-links.ts
# See docs/members-home.md
VITE_STRIPE_CUSTOMER_PORTAL_URL=
